# Copy to .env and fill in. NEVER commit .env
API_KEY=change-me-long-random-string
GEMINI_API_KEY=your-gemini-key-from-aistudio
LLM_MODEL=gemini-3.8-flash
# Optional: tried in order when the main model is out of free-tier quota (429) or unavailable (404)
# LLM_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.6-flash,gemini-3.1-flash-lite
# Optional: per-call output token cap (default 1200)
# MAX_OUTPUT_TOKENS=1200

MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_APP_PASSWORD=change-me-app
MYSQL_RO_PASSWORD=change-me-readonly
